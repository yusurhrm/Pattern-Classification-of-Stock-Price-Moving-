# ============================================================
# PART 3
# COMPARE HIERARCHICAL AND K-MEANS CLUSTER ASSIGNMENTS
# ============================================================


# ============================================================
# File paths
# ============================================================

KMEANS_CLUSTERS_PATH = (
    "results/kmeans_final_clusters.csv"
)

COMPARISON_OUTPUT_PATH = os.path.join(
    RESULTS_DIR,
    "kmeans_hierarchical_assignment_comparison.csv",
)

CONTINGENCY_TABLE_OUTPUT_PATH = os.path.join(
    RESULTS_DIR,
    "kmeans_hierarchical_contingency_table.csv",
)


# ============================================================
# Load K-Means assignments
# ============================================================

kmeans_assignments = pd.read_csv(
    KMEANS_CLUSTERS_PATH
)

required_kmeans_columns = {
    "Ticker",
    "Cluster",
}

if not required_kmeans_columns.issubset(
    kmeans_assignments.columns
):
    raise ValueError(
        "The K-Means assignment file must contain "
        "'Ticker' and 'Cluster' columns."
    )

kmeans_assignments = (
    kmeans_assignments[
        [
            "Ticker",
            "Cluster",
        ]
    ]
    .copy()
)

kmeans_assignments["Ticker"] = (
    kmeans_assignments["Ticker"]
    .astype(str)
    .str.strip()
)

kmeans_assignments["Cluster"] = (
    pd.to_numeric(
        kmeans_assignments["Cluster"],
        errors="raise",
    )
    .astype(int)
)

kmeans_assignments = (
    kmeans_assignments.rename(
        columns={
            "Cluster": "K-Means Cluster",
        }
    )
)


# ============================================================
# Prepare hierarchical assignments
# ============================================================

hierarchical_comparison = (
    cluster_assignments[
        [
            "Ticker",
            "Cluster",
        ]
    ]
    .copy()
)

hierarchical_comparison = (
    hierarchical_comparison.rename(
        columns={
            "Cluster": "Hierarchical Cluster",
        }
    )
)


# ============================================================
# Merge assignments
# ============================================================

assignment_comparison = (
    kmeans_assignments.merge(
        hierarchical_comparison,
        on="Ticker",
        how="outer",
        validate="one_to_one",
        indicator=True,
    )
)

unmatched_rows = assignment_comparison.loc[
    assignment_comparison["_merge"]
    != "both"
]

if not unmatched_rows.empty:
    raise ValueError(
        "Some tickers were not found in both assignment files:\n"
        f"{unmatched_rows.to_string(index=False)}"
    )

assignment_comparison = (
    assignment_comparison.drop(
        columns="_merge"
    )
)


# ============================================================
# Create contingency table
# ============================================================

contingency_table = pd.crosstab(
    assignment_comparison[
        "K-Means Cluster"
    ],
    assignment_comparison[
        "Hierarchical Cluster"
    ],
)

contingency_table.index.name = (
    "K-Means Cluster"
)

contingency_table.columns.name = (
    "Hierarchical Cluster"
)

contingency_table.to_csv(
    CONTINGENCY_TABLE_OUTPUT_PATH
)


# ============================================================
# Infer equivalent cluster labels
# ============================================================

hierarchical_to_kmeans_map = {}

for hierarchical_cluster in sorted(
    assignment_comparison[
        "Hierarchical Cluster"
    ].unique()
):

    current_rows = assignment_comparison.loc[
        assignment_comparison[
            "Hierarchical Cluster"
        ]
        == hierarchical_cluster
    ]

    matching_counts = (
        current_rows[
            "K-Means Cluster"
        ]
        .value_counts()
    )

    most_common_kmeans_cluster = int(
        matching_counts.idxmax()
    )

    hierarchical_to_kmeans_map[
        hierarchical_cluster
    ] = most_common_kmeans_cluster


assignment_comparison[
    "Mapped Hierarchical Cluster"
] = (
    assignment_comparison[
        "Hierarchical Cluster"
    ]
    .map(
        hierarchical_to_kmeans_map
    )
)


# ============================================================
# Determine assignment agreement
# ============================================================

assignment_comparison[
    "Same Pattern Assignment"
] = (
    assignment_comparison[
        "K-Means Cluster"
    ]
    == assignment_comparison[
        "Mapped Hierarchical Cluster"
    ]
)

agreement_count = int(
    assignment_comparison[
        "Same Pattern Assignment"
    ].sum()
)

total_companies = len(
    assignment_comparison
)

agreement_percentage = (
    agreement_count
    / total_companies
    * 100
)

assignment_comparison = (
    assignment_comparison.sort_values(
        by=[
            "K-Means Cluster",
            "Ticker",
        ]
    )
    .reset_index(
        drop=True
    )
)

assignment_comparison.to_csv(
    COMPARISON_OUTPUT_PATH,
    index=False,
)


# ============================================================
# Print comparison results
# ============================================================

print("\n" + "=" * 80)
print("K-MEANS AND HIERARCHICAL CLUSTER COMPARISON")
print("=" * 80)

print("\nContingency table:")

print(
    contingency_table.to_string()
)

print(
    "\nHierarchical-to-K-Means label mapping:"
)

for (
    hierarchical_cluster,
    kmeans_cluster,
) in hierarchical_to_kmeans_map.items():

    print(
        f"Hierarchical Cluster "
        f"{hierarchical_cluster} "
        f"corresponds to K-Means Cluster "
        f"{kmeans_cluster}"
    )

print(
    f"\nMatching pattern assignments: "
    f"{agreement_count}/{total_companies}"
)

print(
    f"Agreement percentage: "
    f"{agreement_percentage:.2f}%"
)


# ============================================================
# Print disagreements, if any
# ============================================================

disagreements = assignment_comparison.loc[
    ~assignment_comparison[
        "Same Pattern Assignment"
    ]
]

if disagreements.empty:

    print(
        "\nThe two algorithms assigned every company "
        "to the same movement pattern after aligning "
        "the arbitrary cluster labels."
    )

else:

    print(
        "\nCompanies assigned differently:"
    )

    print(
        disagreements[
            [
                "Ticker",
                "K-Means Cluster",
                "Hierarchical Cluster",
                "Mapped Hierarchical Cluster",
            ]
        ].to_string(
            index=False
        )
    )


